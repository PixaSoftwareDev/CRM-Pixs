# /opt/crm/deploy/.env en el VPS. Generar cada secreto con: openssl rand -base64 32
# (no los pegues en chats ni en el repo).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Clave de Accesos: si se pierde, las claves guardadas no se pueden leer. Guardarla aparte.
VAULT_KEY=
VAULT_KEY_VERSION=1
# URL pública (solo el origen, sin la ruta): con https las cookies pasan a ser Secure solas.
BETTER_AUTH_URL=http://200.58.109.110
WEB_ORIGIN=http://200.58.109.110
LOG_LEVEL=info
SCHEDULER_ENABLED=true
# Botón "Acceso de prueba" en el login (opcional). OJO: la clave queda en el código
# publicado y cualquiera con el link entra. Solo para probar sin datos reales.
# Para sacarlo: borrar estas dos líneas y `docker compose up -d --build`.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
