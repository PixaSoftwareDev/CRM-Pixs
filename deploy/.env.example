# /opt/crm-pixs/deploy/.env en el VPS. Generar cada secreto con: openssl rand -base64 32
# (no los pegues en chats ni en el repo).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Clave de Accesos: si se pierde, las claves guardadas no se pueden leer. Guardarla aparte.
VAULT_KEY=
VAULT_KEY_VERSION=1
# URL pública (sin /crmpixs): con https las cookies pasan a ser Secure solas.
BETTER_AUTH_URL=http://200.58.109.110
WEB_ORIGIN=http://200.58.109.110
LOG_LEVEL=info
SCHEDULER_ENABLED=true
