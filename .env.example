# === Base de datos (SQLite local) ===
# La app usa SQLite (better-sqlite3). No hay servidor ni credenciales.
# Opcional: cambiar la ruta del archivo de la base (default: demo.sqlite).
# SQLITE_PATH="demo.sqlite"

# === Auth local por cookie ===
# La contraseña es compartida para todos los usuarios (login local, sin proveedor externo).
DEMO_PASSWORD="demo1234"
DEMO_EMAIL="admin@pixs.com"

# === Cifrado de secretos ===
ENCRYPTION_KEY="[clave-maestra-base64]"          # SOLO server. Nunca en la base ni en el repo.

# === Email / Alertas (opcional) ===
RESEND_API_KEY="[resend-key]"
ALERT_EMAIL_FROM="Pixs CRM <alertas@tudominio.com>"
ALERT_EMAIL_TO="socio1@pixs.com,socio2@pixs.com"   # coma-separado
CRON_SECRET="[secreto-para-el-endpoint-de-cron]"    # el cron lo manda en Authorization

# === Captación / Scraping (opcional) ===
ANTHROPIC_API_KEY="[anthropic-key]"                 # enriquecimiento con Claude
GOOGLE_PLACES_API_KEY="[google-places-key]"         # recolección de leads
