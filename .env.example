# === Base de datos (Postgres / Supabase) ===
# Usar el POOLER para serverless (puerto 6543), no la conexión directa.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Conexión directa (puerto 5432) — solo para migraciones con drizzle-kit.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"   # SOLO en el server, nunca al cliente

# === Cifrado de secretos (§4 del plan) ===
ENCRYPTION_KEY="[clave-maestra-base64]"          # SOLO server. Nunca en la base ni en el repo.

# === Email / Alertas (Fase 3) ===
RESEND_API_KEY="[resend-key]"
ALERT_EMAIL_FROM="Pixs CRM <alertas@tudominio.com>"
ALERT_EMAIL_TO="socio1@pixs.com,socio2@pixs.com"   # coma-separado
CRON_SECRET="[secreto-para-el-endpoint-de-cron]"    # pg_cron lo manda en Authorization

# === Captación / Scraping (Fase 4) ===
ANTHROPIC_API_KEY="[anthropic-key]"                 # enriquecimiento con Claude
GOOGLE_PLACES_API_KEY="[google-places-key]"         # recolección de leads
