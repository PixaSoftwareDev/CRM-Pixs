# Copiar a .env (no va a git). Valores de desarrollo local.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://crm:crm_dev@127.0.0.1:54329/crm
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Proxies de los que se acepta X-Forwarded-For. En desarrollo ninguno (se usa la IP del socket).
# TRUST_PROXY=false
# Clave de Accesos: openssl rand -base64 32 (guardarla aparte: sin ella no se pueden leer las claves)
VAULT_KEY=
VAULT_KEY_VERSION=1
SCHEDULER_ENABLED=true
