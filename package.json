{
  "name": "crm",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @crm/api --filter @crm/web dev",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @crm/db generate",
    "db:migrate": "pnpm --filter @crm/db migrate",
    "db:seed": "pnpm --filter @crm/db seed",
    "db:studio": "pnpm --filter @crm/db studio",
    "user:dev": "pnpm --filter @crm/api user:dev",
    "seed:demo": "pnpm --filter @crm/api seed:demo",
    "test": "pnpm -r --if-present test",
    "test:e2e": "node tests/e2e/api.e2e.mjs"
  }
}
