{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "user:dev": "tsx --env-file=../../.env --env-file=../web/.env.development.local src/scripts/seed-dev-user.ts",
    "seed:demo": "tsx --env-file=../../.env src/scripts/seed-demo.ts",
    "test": "vitest run",
    "start": "node --import tsx src/index.ts",
    "migrate": "node --import tsx src/scripts/migrate.ts",
    "create-user": "node --import tsx src/scripts/create-user.ts"
  },
  "dependencies": {
    "@crm/db": "workspace:*",
    "@crm/shared": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.7",
    "better-auth": "^1.7.23",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
